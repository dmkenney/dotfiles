#!/home/dylan/.local/share/mise/installs/python/3.11.9/bin/python3
"""Unstick Brave paste without restarting.

Brave (Chromium 150+) waits forever for a reply to each X11 clipboard request,
in a FIFO queue. If a clipboard owner never answers, every later paste waits
behind it. This sends Brave's windows SelectionNotify(property=None), i.e.
"request failed", for common selections/targets, so the stuck request is
dropped and the queue moves on. Mismatched events are ignored by Brave.
"""
import subprocess
from Xlib import display, X
from Xlib.protocol import event
from Xlib.ext import res

pid = int(subprocess.run(["pgrep", "-o", "-x", "brave"], capture_output=True, text=True, check=True).stdout)
d = display.Display(); root = d.screen().root
def wpid(w):
    try: return d.res_query_client_ids([{'client': w.id, 'mask': res.LocalClientPIDMask}]).ids[0].value[0]
    except Exception: return None
wins = [w for w in root.query_tree().children if wpid(w) == pid]
print("brave top-level windows:", len(wins))
sels = [d.intern_atom(s) for s in ("CLIPBOARD", "PRIMARY")]
tnames = ["TARGETS", "UTF8_STRING", "STRING", "TEXT", "text/plain;charset=utf-8", "text/plain",
          "text/html", "text/uri-list", "image/png", "chromium/x-web-custom-data", "TIMESTAMP",
          "chromium/x-source-url", "text/rtf", "chromium/x-internal-source-rfh-token"]
targets = [d.intern_atom(t) for t in tnames]
n = 0
for w in wins:
    for s in sels:
        for t in targets:
            w.send_event(event.SelectionNotify(time=X.CurrentTime, requestor=w, selection=s, target=t, property=X.NONE))
            n += 1
d.flush(); d.sync()
print("sent", n, "SelectionNotify(property=None) events")
