#!/bin/bash
# Voxtype meeting transcript (mic + desktop audio), with an optional screen recording.
#
#   meeting-toggle          stop the running meeting, or open the Meeting menu
#   meeting-toggle audio    start: transcript only
#   meeting-toggle screen   start: also record a monitor or region (Omarchy's picker)
#   meeting-toggle window   start: also record one window (xdg-desktop-portal picker)
#
# On stop, the transcript is saved to ~/Documents/meetings. Super+Ctrl+M runs this
# (omarchy/hypr/bindings.lua); the menu is in omarchy/extensions/omarchy-menu.jsonc.

out_dir=~/Documents/meetings

running() {
  voxtype meeting status 2>/dev/null | grep -q 'Meeting Status: \(starting\|recording\|paused\)'
}

meeting_id() {
  voxtype meeting status 2>/dev/null | sed -n 's/^Meeting ID: //p'
}

# Held for the whole stop, so a second press can't start a meeting while the
# last one is still being saved.
lock_file="${XDG_RUNTIME_DIR:-/tmp}/meeting-toggle.lock"
exec {lock_fd}>"$lock_file"

stopping() {
  ! flock -n "$lock_fd"
}

stop_meeting() {
  flock -n "$lock_fd" || { notify-send "Meeting still stopping" "Wait for the last meeting to finish saving"; return; }

  # Export this meeting by ID: "latest" can be a newer meeting started meanwhile.
  id=$(meeting_id)
  notify-send "Stopping meeting" "Saving the transcript..."
  voxtype meeting stop >/dev/null

  # The daemon finishes transcribing the last chunk after stop.
  for _ in $(seq 30); do
    [[ $(meeting_id) == "$id" ]] || break
    sleep 1
  done

  mkdir -p "$out_dir"
  file="$out_dir/$(date +%F-%H%M).md"
  if [[ -n $id ]] && voxtype meeting export "$id" --timestamps --speakers --metadata -o "$file" >/dev/null 2>&1; then
    notify-send "Meeting stopped" "Transcript: $file"
  else
    notify-send -u critical "Meeting stopped" "Transcript export failed. Try: voxtype meeting list"
  fi

  # Last: saving a long screen recording can take a minute.
  omarchy-capture-screenrecording --status >/dev/null 2>&1 && omarchy-capture-screenrecording --stop-recording {lock_fd}>&-
}

if stopping; then
  notify-send "Meeting still stopping" "Wait for the last meeting to finish saving"
  exit 0
fi
flock -u "$lock_fd"

case $1 in
  "")
    if running; then stop_meeting; else omarchy-menu summon meeting; fi
    exit 0
    ;;
  audio | screen | window) ;;
  *) echo "Usage: meeting-toggle [audio|screen|window]" >&2; exit 1 ;;
esac

if running; then
  notify-send "Meeting already running" "Press Super+Ctrl+M to stop it"
  exit 0
fi

voxtype meeting start >/dev/null || { notify-send -u critical "Meeting failed to start"; exit 1; }

# Desktop audio and mic go into the video too; the transcript records them separately.
case $1 in
  audio)
    notify-send "Meeting transcript started" "Press Super+Ctrl+M to stop"
    ;;
  screen)
    notify-send "Meeting transcript started" "Pick a monitor or region to record"
    omarchy-capture-screenrecording --with-desktop-audio --with-microphone-audio {lock_fd}>&-
    ;;
  window)
    notify-send "Meeting transcript started" "Pick a window to record"
    OMARCHY_SCREENRECORD_USE_PORTAL=true omarchy-capture-screenrecording --with-desktop-audio --with-microphone-audio {lock_fd}>&-
    ;;
esac
