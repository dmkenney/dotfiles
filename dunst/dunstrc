# dunst config — TokyoNight, bottom-right, follows keyboard focus.
# Symlinked to ~/.config/dunst/dunstrc by install.sh.

[global]
    follow = keyboard
    origin = bottom-right
    offset = 10x40
    width = 350
    height = 150
    font = CaskaydiaCove Nerd Font 10
    frame_width = 1
    corner_radius = 0
    separator_height = 1
    padding = 8
    horizontal_padding = 10
    idle_threshold = 120
    mouse_left_click = close_current
    mouse_right_click = close_all
    mouse_middle_click = do_action

[urgency_low]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#3b4261"
    timeout = 5

[urgency_normal]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#3b4261"
    timeout = 8

[urgency_critical]
    background = "#1a1b26"
    foreground = "#c0caf5"
    frame_color = "#f7768e"
    timeout = 0
