# i3status configuration file.
# see "man i3status" for documentation.

# It is important that this file is edited as UTF-8.
# The following line should contain a sharp s:
# ß
# If the above line is not correctly displayed, fix your editor first!

general {
        colors = true
        interval = 5
        color_good = "#a0a0a0"
        color_degraded = "#ffb52a"
        color_bad = "#ff4d4d"
}

order += "wireless _first_"
order += "ethernet _first_"
order += "cpu_temperature 0"
order += "disk /"
order += "load"
order += "memory"
order += "tztime local"

wireless _first_ {
        format_up = "W: (%quality at %essid) %ip"
        format_down = "W: down"
}

ethernet _first_ {
        format_up = "E: %ip (%speed)"
        format_down = "E: down"
}

# CPU package temperature. Uses the stable platform path rather than
# /sys/class/hwmon/hwmonN, whose numbering can change across reboots.
#
# Grey normally, red above 75°C. i3status 2.15 supports only this single
# threshold for this module. The cores trip their "high" limit at 82°C and
# throttle at 100°C, so 75 gives some warning before either.
cpu_temperature 0 {
        format = "CPU %degrees°C"
        path = "/sys/devices/platform/coretemp.0/hwmon/hwmon*/temp1_input"
        max_threshold = 75
        format_above_threshold = "CPU HOT %degrees°C"
}

disk "/" {
        format = "%avail"
}

load {
        format = "%1min"
}

memory {
        format = "%used | %available"
        threshold_degraded = "1G"
        format_degraded = "MEMORY < %available"
}

tztime local {
        format = "%Y-%m-%d %H:%M:%S"
}
